# ============================================================================
# PLANTILLA DE CONFIGURACIÓN MULTI-AGENTE 100% LOCAL (PRIVACIDAD RGPD)
# Ningún documento, PDF, foto o vídeo sale de tu ordenador (localhost).
# ============================================================================

# Modo Privacidad Estricta Legal (true = 100% localhost, desactiva envíos externos)
PRIVACY_LOCAL_ONLY=true

# Servidor de IA Local (Ollama en localhost)
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_TEXT_MODEL=qwen2.5:3b
LOCAL_VISION_MODEL=moondream

# Puerto del servidor local del Robot
PORT=3001

# ============================================================================
# SINCRONIZACIÓN OPCIONAL CON NUBE (Desactivada si PRIVACY_LOCAL_ONLY=true)
# ============================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_key_aqui
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_key_aqui
VITE_APP_PASSWORD=


