# ============================================================================
# PLANTILLA DE CONFIGURACIÓN Y SECRETOS (SEGURO PARA SUBIR A GITHUB)
# Copia este archivo como ".env" en esta misma carpeta y pon tu clave real.
# El archivo ".env" está bloqueado en .gitignore y NUNCA se subirá a GitHub.
# ============================================================================

# Clave de API de Google Gemini (Consíguela gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de IA a utilizar (por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor local del Robot
PORT=3001

# ============================================================================
# SINCRONIZACIÓN HÍBRIDA CON LA NUBE (SUPABASE + VERCEL) - OPCIONAL
# Permite acceder a los expedientes desde cualquier lugar (móvil, juzgado, casa)
# ============================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_key_aqui

# Variables para el Frontend Web en la nube (Vercel / Vite)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_key_aqui
VITE_APP_PASSWORD=

